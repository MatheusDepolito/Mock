{
  "components": {
    "schemas": {
      "HealthLiveResponseDto": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HealthReadyChecksDto": {
        "properties": {
          "application": {
            "enum": [
              "up"
            ],
            "example": "up",
            "type": "string"
          },
          "database": {
            "enum": [
              "up"
            ],
            "example": "up",
            "type": "string"
          },
          "redis": {
            "enum": [
              "up"
            ],
            "example": "up",
            "type": "string"
          }
        },
        "required": [
          "application",
          "database",
          "redis"
        ],
        "type": "object"
      },
      "HealthReadyResponseDto": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/HealthReadyChecksDto"
          },
          "status": {
            "enum": [
              "ok"
            ],
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": {
            "description": "Stable error code, from the API error catalog.",
            "enum": [
              "VALIDATION_ERROR",
              "NOT_FOUND",
              "RATE_LIMIT_EXCEEDED",
              "INTERNAL_SERVER_ERROR",
              "SERVICE_UNAVAILABLE"
            ],
            "example": "SERVICE_UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "description": "Explanation specific to this occurrence, meant for diagnostics and logging (not for UI text).",
            "example": "PostgreSQL is not ready.",
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Validation failures only: field name to the list of messages for that field.",
            "type": "object"
          },
          "instance": {
            "description": "Path of the request that produced the error.",
            "example": "/api/v1/health/ready",
            "type": "string"
          },
          "requestId": {
            "description": "The same correlation id returned in the X-Request-Id response header.",
            "example": "4d0f2d7a-3b9a-4c8e-9a52-6b1f7f1c2a10",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code, repeated in the body.",
            "example": 503,
            "type": "number"
          },
          "title": {
            "description": "Short, human-readable summary of the problem type.",
            "example": "Service Unavailable",
            "type": "string"
          },
          "type": {
            "description": "Stable URI-reference identifying the problem type.",
            "example": "https://api.mockp.dev/problems/service-unavailable",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Mockp platform REST API.",
    "title": "Mockp API",
    "version": "1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "health_live",
        "parameters": [
          {
            "description": "Optional correlation id. Used as-is when it matches the documented pattern; otherwise the API replaces it with a generated UUID.",
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponseDto"
                }
              }
            },
            "description": "",
            "headers": {
              "X-Request-Id": {
                "description": "Echoes the valid X-Request-Id sent in the request, or a UUID generated by the API.",
                "schema": {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]{1,128}$",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "Unexpected error (INTERNAL_SERVER_ERROR).",
            "headers": {
              "X-Request-Id": {
                "description": "Echoes the valid X-Request-Id sent in the request, or a UUID generated by the API.",
                "schema": {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]{1,128}$",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Liveness probe (process is up; checks no dependency)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "health_ready",
        "parameters": [
          {
            "description": "Optional correlation id. Used as-is when it matches the documented pattern; otherwise the API replaces it with a generated UUID.",
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponseDto"
                }
              }
            },
            "description": "",
            "headers": {
              "X-Request-Id": {
                "description": "Echoes the valid X-Request-Id sent in the request, or a UUID generated by the API.",
                "schema": {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]{1,128}$",
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "Unexpected error (INTERNAL_SERVER_ERROR).",
            "headers": {
              "X-Request-Id": {
                "description": "Echoes the valid X-Request-Id sent in the request, or a UUID generated by the API.",
                "schema": {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]{1,128}$",
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            },
            "description": "A required dependency is not ready (SERVICE_UNAVAILABLE). No `checks` field; `detail` is a static message naming the failed dependency (PostgreSQL, Redis, or both).",
            "headers": {
              "X-Request-Id": {
                "description": "Echoes the valid X-Request-Id sent in the request, or a UUID generated by the API.",
                "schema": {
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]{1,128}$",
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Readiness probe (PostgreSQL/PostGIS and Redis are usable)",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
