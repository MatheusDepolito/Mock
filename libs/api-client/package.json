{
  "name": "@mockp/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "nx": {
    "name": "api-client",
    "sourceRoot": "libs/api-client/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "libs/api-client/dist",
          "main": "libs/api-client/src/index.ts",
          "tsConfig": "libs/api-client/tsconfig.build.json",
          "assets": [
            "libs/api-client/*.md"
          ]
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -b tsconfig.json",
          "cwd": "libs/api-client"
        }
      },
      "contract:generate": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "api"
            ],
            "target": "contract:generate"
          }
        ],
        "options": {
          "command": "node libs/api-client/scripts/generate-types.mjs"
        }
      },
      "contract:check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node libs/api-client/scripts/check-types.mjs"
        }
      }
    }
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
