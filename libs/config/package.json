{
  "name": "@mockp/config",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./server": {
      "types": "./src/server/index.ts",
      "development": "./src/server/index.ts",
      "default": "./dist/src/server/index.js"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "development": "./src/worker/index.ts",
      "default": "./dist/src/worker/index.js"
    }
  },
  "nx": {
    "name": "config",
    "sourceRoot": "libs/config/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "libs/config/dist",
          "main": "libs/config/src/server/index.ts",
          "tsConfig": "libs/config/tsconfig.build.json",
          "assets": [
            "libs/config/*.md"
          ]
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -b tsconfig.json",
          "cwd": "libs/config"
        }
      }
    }
  },
  "dependencies": {
    "tslib": "2.8.1",
    "zod": "4.5.4"
  }
}
