{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/api/spec",
    "tsBuildInfoFile": "../../dist/out-tsc/apps/api/spec/spec.tsbuildinfo",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": ".",
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ]
  },
  "references": [{ "path": "./tsconfig.app.json" }],
  "include": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "prisma*.config.ts"
  ]
}
