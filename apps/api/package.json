{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "dependsOn": [
          "^build",
          "db:generate"
        ],
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/api",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.build.json"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        }
      },
      "test": {
        "dependsOn": [
          "db:generate"
        ]
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          "db:generate"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/coverage/apps/api-integration"
        ],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "apps/api"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^typecheck",
          "db:generate"
        ],
        "options": {
          "command": "tsc -b tsconfig.json",
          "cwd": "apps/api"
        }
      },
      "db:validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma/prisma-config.shared.ts",
          "{projectRoot}/prisma.config.ts",
          "{projectRoot}/package.json",
          "{workspaceRoot}/yarn.lock"
        ],
        "options": {
          "command": "prisma validate --config prisma.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/prisma/schema.prisma",
          "{projectRoot}/prisma/prisma-config.shared.ts",
          "{projectRoot}/prisma.config.ts",
          "{projectRoot}/package.json",
          "{workspaceRoot}/yarn.lock"
        ],
        "outputs": [
          "{projectRoot}/src/generated/prisma-client"
        ],
        "options": {
          "command": "prisma generate --config prisma.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:migrate:dev": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma migrate dev --config prisma.migrate.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:migrate:deploy": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma migrate deploy --config prisma.migrate.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:migrate:deploy:test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma migrate deploy --config prisma.test.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma db seed --config prisma.migrate.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:seed:test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma db seed --config prisma.test.config.ts",
          "cwd": "apps/api"
        }
      },
      "db:reset": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "prisma migrate reset --config prisma.migrate.config.ts",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@mockp/config": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.13"
  }
}
