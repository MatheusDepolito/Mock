{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/api",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.build.json"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/coverage/apps/api-integration"
        ],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "apps/api"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -b tsconfig.json",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@mockp/config": "workspace:*"
  }
}
