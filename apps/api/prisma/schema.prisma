// Prisma schema for the Mockp multi-tenant core data model — Tarefa 3.2
// reimplementation conforme docs/adr/007-multi-tenant-workspace-foundation.md
// (Accepted). Every field, relation, uniqueness constraint, mapping and
// onDelete policy here mirrors that ADR exactly. Do not add entities or
// fields beyond what it approved.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  CUSTOMER
  ADMIN
}

enum WorkspaceType {
  INDIVIDUAL
  BROKERAGE
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum WorkspaceMemberRole {
  MANAGER
  AGENT
}

enum WorkspaceAgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String     @unique @db.Citext
  status        UserStatus @default(ACTIVE)
  deactivatedAt DateTime?  @map("deactivated_at") @db.Timestamptz(3)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  credential           Credential?
  authIdentities       AuthIdentity[]
  userRoles            UserRole[]
  customerProfile      CustomerProfile?
  agentProfile         AgentProfile?
  workspaceMemberships WorkspaceMembership[]
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")

  @@map("users")
}

model Credential {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model AuthIdentity {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.Text
  providerAccountId String   @map("provider_account_id") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

// Catalog table: id is NOT generated by the database — Role is a
// versioned, deterministic catalog (only CUSTOMER/ADMIN), seeded with
// fixed, explicit UUIDs (see prisma/seed.ts). This is the sole
// exception to the UUIDv7-default convention used everywhere else in
// this schema. See docs/adr/007-multi-tenant-workspace-foundation.md
// ("Papéis globais reduzidos").
model Role {
  id        String   @id @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model CustomerProfile {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model AgentProfile {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenses        AgentLicense[]
  workspaceAgents WorkspaceAgent[]

  @@map("agent_profiles")
}

model AgentLicense {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  agentProfileId   String   @map("agent_profile_id") @db.Uuid
  countryCode      String   @map("country_code") @db.Char(2)
  // Case-insensitive: SP/sp/Sp must collide as the same jurisdiction —
  // see docs/adr/007-multi-tenant-workspace-foundation.md.
  jurisdictionCode String   @map("jurisdiction_code") @db.Citext
  licenseNumber    String   @map("license_number") @db.Citext
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@unique([countryCode, jurisdictionCode, licenseNumber])
  @@index([agentProfileId])
  @@map("agent_licenses")
}

model Workspace {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        WorkspaceType
  name        String          @db.Text
  slug        String          @unique @db.Citext
  ownerUserId String          @map("owner_user_id") @db.Uuid
  status      WorkspaceStatus @default(ACTIVE)
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz(3)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Owner is a User — deletion is restricted (see onDelete below); the
  // owner's actual operational permissions still come exclusively from
  // WorkspaceMembership/WorkspaceMembershipRole/WorkspaceAgent, never
  // from this field alone (see ADR 007, "Ownership").
  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships WorkspaceMembership[]
  brokerage   Brokerage?
  properties  Property[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String                    @map("workspace_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  status      WorkspaceMembershipStatus @default(ACTIVE)
  joinedAt    DateTime                  @default(now()) @map("joined_at") @db.Timestamptz(3)
  endedAt     DateTime?                 @map("ended_at") @db.Timestamptz(3)
  version     Int                       @default(1)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     WorkspaceMembershipRole[]
  // Reverse side of WorkspaceAgent's composite FK
  // (workspaceId, userId) -> WorkspaceMembership(workspaceId, userId).
  agent     WorkspaceAgent?

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

model WorkspaceMembershipRole {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  membershipId String              @map("membership_id") @db.Uuid
  role         WorkspaceMemberRole
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("workspace_membership_roles")
}

model WorkspaceAgent {
  id          String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String               @map("workspace_id") @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  status      WorkspaceAgentStatus @default(ACTIVE)
  revokedAt   DateTime?            @map("revoked_at") @db.Timestamptz(3)
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Composite FK: only exists for someone who is already a member of
  // THAT workspace. Losing the membership cascades away the agent
  // authorization automatically.
  membership               WorkspaceMembership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  // Simple FK: guarantees the user actually has an AgentProfile. Never
  // cascades — an AgentProfile referenced here can't be deleted without
  // first revoking the authorization.
  agentProfile             AgentProfile        @relation(fields: [userId], references: [userId], onDelete: Restrict)
  // Properties whose responsible agent is this WorkspaceAgent (matched
  // via the composite FK on Property, see below) — a Property may keep
  // pointing at a SUSPENDED/REVOKED WorkspaceAgent to preserve history.
  responsibleForProperties Property[]

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@map("workspace_agents")
}

model Brokerage {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  legalName   String   @map("legal_name") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("brokerages")
}

model Property {
  id                     String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId            String         @map("workspace_id") @db.Uuid
  responsibleAgentUserId String         @map("responsible_agent_user_id") @db.Uuid
  title                  String         @db.Text
  price                  Decimal        @db.Decimal(12, 2)
  currency               String         @db.Char(3)
  status                 PropertyStatus @default(DRAFT)
  publishedAt            DateTime?      @map("published_at") @db.Timestamptz(3)
  archivedAt             DateTime?      @map("archived_at") @db.Timestamptz(3)
  version                Int            @default(1)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  // Composite FK: guarantees the responsible agent belongs to THIS same
  // workspace — structurally impossible to reference an agent from
  // another tenant. Does not require status = ACTIVE, so an existing
  // Property stays valid even if the WorkspaceAgent is later
  // suspended/revoked (history preserved).
  responsibleAgent WorkspaceAgent @relation(fields: [workspaceId, responsibleAgentUserId], references: [workspaceId, userId], onDelete: Restrict)
  address          Address?

  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, responsibleAgentUserId, status])
  @@index([status, publishedAt])
  @@map("properties")
}

model Address {
  id           String                                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String                                @map("workspace_id") @db.Uuid
  propertyId   String                                @unique @map("property_id") @db.Uuid
  // International structure: no Brazil-specific required fields (e.g.
  // streetNumber/neighborhood) — addressLine1/addressLine2/district
  // cover that granularity generically. See
  // docs/adr/007-multi-tenant-workspace-foundation.md.
  addressLine1 String                                @map("address_line_1") @db.Text
  addressLine2 String?                               @map("address_line_2") @db.Text
  district     String?                               @db.Text
  countryCode  String                                @map("country_code") @db.Char(2)
  regionCode   String                                @map("region_code") @db.Text
  locality     String                                @db.Text
  postalCode   String                                @map("postal_code") @db.Text
  // PostGIS geography column — not natively supported by the Prisma
  // Client. Read/write happens via parameterized raw SQL (tagged
  // template `Prisma.sql`) in PropertyRepository (Tarefa 3.3), never
  // through the typed Client.
  location     Unsupported("geography(Point, 4326)")
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Composite FK: guarantees the address belongs to the SAME workspace
  // as its property — structurally impossible to reference a property
  // from another tenant.
  property Property @relation(fields: [workspaceId, propertyId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, propertyId])
  @@map("addresses")
}
