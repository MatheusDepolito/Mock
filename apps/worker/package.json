{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist/apps/worker",
          "main": "apps/worker/src/main.ts",
          "tsConfig": "apps/worker/tsconfig.build.json"
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "worker:build",
          "runBuildTargetDependencies": false
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/coverage/apps/worker-integration"
        ],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "apps/worker"
        }
      },
      "test:integration:infra": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config vitest.integration.infra.config.mts",
          "cwd": "apps/worker"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -b tsconfig.json",
          "cwd": "apps/worker"
        }
      }
    }
  },
  "dependencies": {
    "@mockp/config": "workspace:*",
    "@mockp/queue": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
