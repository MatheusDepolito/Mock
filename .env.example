# Copy to .env for local development. Never commit the real .env file.
# See docs/TARGET_ARCHITECTURE.md (section 9), docs/adr/005-api-runtime.md
# and docs/adr/006-persistence-and-local-infrastructure.md.
#
# The values below are local development defaults matching
# docker-compose.yml (Tarefa 3.1) — not secrets. Never reuse them outside a
# local machine.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Docker Compose (profile padrão) — PostgreSQL/PostGIS
POSTGRES_USER=mockp
POSTGRES_PASSWORD=mockp
POSTGRES_DB=mockp

# ServerConfig (server-only, obrigatórias para a API subir)
DATABASE_URL=postgresql://mockp:mockp@localhost:5432/mockp
REDIS_URL=redis://localhost:6379

# Exclusiva de testes/scripts — nunca lida pelo ServerConfig, nunca exigida
# para iniciar a API (ver docs/adr/006-persistence-and-local-infrastructure.md).
TEST_DATABASE_URL=postgresql://mockp:mockp@localhost:5432/mockp_test
